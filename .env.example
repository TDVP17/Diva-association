# Environment variables declared in this file are NOT automatically loaded by Prisma CLI.
# prisma.config.ts already imports "dotenv/config" so `.env` is loaded for `prisma` commands.
# Copy this file to `.env` and fill in real values before running the app.

# --- Database (PostgreSQL) ---
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/diva_associations?schema=public"

DIRECT_URL=""
# Only needed for `prisma migrate dev`/`diff` against a hosting provider that
# doesn't let Prisma create shadow databases on the fly (e.g. some managed
# Postgres). Safe to leave unset for local Postgres.
SHADOW_DATABASE_URL=""




# --- Auth (Auth.js / NextAuth v5) ---
AUTH_SECRET="replace-with-openssl-rand--base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth client (console.cloud.google.com > APIs & Services > Credentials)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Supabase Storage (receipts) + Supabase Auth (email/password) ---
# Dashboard: Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
# Dashboard: Project Settings > API Keys > "Publishable key" (sb_publishable_...).
# Replaces the legacy "anon" key — same purpose, respects RLS. Used both for
# email/password auth (src/lib/supabase-auth.ts) and documented for any
# future client-side Storage use.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Also used by prisma/seed.ts (via getSupabaseAdminClient) to create/reset the
# seeded Super Admin's real Supabase Auth login — not just its Prisma row.
SUPABASE_SERVICE_ROLE_KEY=""
# Dashboard: Storage > create a private bucket, then put its name here.
SUPABASE_STORAGE_BUCKET=""

# Password for the seeded Super Admin (admin@diva-associations.cm) created by
# `npm run db:seed`. Optional — falls back to a default if unset (printed to
# the console either way after seeding).
SEED_ADMIN_PASSWORD=""

# --- Fapshi Service 1: Collection (encaissement cotisations & cautions) ---
# Docs: https://docs.fapshi.com
FAPSHI_API_KEY=""
FAPSHI_API_USER=""
# "https://sandbox.fapshi.com" en test, "https://live.fapshi.com" en production
FAPSHI_BASE_URL="https://sandbox.fapshi.com"
# Secret configuré sur le dashboard Fapshi (vérifié via le header x-wh-secret du webhook)
FAPSHI_WEBHOOK_SECRET=""

# --- Fapshi Service 2: Disbursement / Payouts (reversements de cagnottes & remboursements) ---
# Service dédié distinct (ex: divaasso-payouts).
# ATTENTION (Règle Fapshi) : Un service configuré pour les décaissements (/payout)
# ne peut JAMAIS servir à la collecte. Ne pas réutiliser les clés de collecte !
# Note: Sur Fapshi Live, les décaissements doivent être activés par email à support@fapshi.com.
FAPSHI_PAYOUT_API_USER=""
FAPSHI_PAYOUT_API_KEY=""
# "https://sandbox.fapshi.com" en test, "https://live.fapshi.com" en production
FAPSHI_PAYOUT_BASE_URL="https://sandbox.fapshi.com"

# --- Didit (identity verification, https://docs.didit.me) ---
# Dashboard: Business Console > API Keys
DIDIT_API_KEY=""
# The verification "workflow" configured in the Didit dashboard (defines the
# CNI/passport document checks + selfie face-match/liveness capture flow).
DIDIT_WORKFLOW_ID=""
DIDIT_BASE_URL="https://verification.didit.me"
# Shared secret configured on the Didit webhook settings page; used to verify
# the `X-Signature-Simple` header on every POST to /api/kyc/webhook.
DIDIT_WEBHOOK_SECRET=""

# --- Cron auth (Vercel Cron sends this as `Authorization: Bearer <value>`) ---
CRON_SECRET="replace-with-a-long-random-string"

# --- Evolution API (WhatsApp integration) ---
EVOLUTION_API_URL="http://localhost:8080"
EVOLUTION_API_KEY=""
EVOLUTION_INSTANCE_NAME="diva-association"

# --- Resend (email notifications, https://resend.com) ---
# Dashboard: API Keys > Create API Key.
RESEND_API_KEY=""
# Must be on a domain verified in the Resend dashboard (Domains > Add Domain)
# before real sends will succeed — unverified/default addresses only work
# for sending to the account owner's own inbox.
RESEND_FROM="DIVA Associations <notifications@diva-associations.cm>"

# --- Mobile distribution ---
# URL of a hosted, signed Android .apk (or .aab-derived apk) for the
# "Download Android App" button. No Android build toolchain exists in this
# project's dev environment — generate the file externally (easiest free
# path: paste the deployed site's URL into pwabuilder.com, which reads
# /manifest.json and packages a signed Android app) and host it anywhere
# public, then put that URL here. Leave unset to hide the button entirely.
NEXT_PUBLIC_ANDROID_APK_URL=""

# --- Web Push (background notifications + app badging) ---
# Generate a key pair with `npx web-push generate-vapid-keys`. Public key is
# safe to expose to the browser (NEXT_PUBLIC_); private key is server-only.
# Until all three are set, PushPermissionPrompt stays hidden and
# sendPushToUser() is a no-op (logs a clear warning instead of failing).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# A contact URL/email the push services can reach you at if they need to
# flag abuse — mailto: or https:, e.g. "mailto:admin@diva-associations.cm".
VAPID_SUBJECT=""
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
