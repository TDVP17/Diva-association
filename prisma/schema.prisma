// Prisma schema for DIVA Association
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ADMIN
  /// Full admin access plus the global, cross-contribution financial view
  /// (total fees, fines) that ordinary admins cannot see — see
  /// requirePresident() in src/lib/require-admin.ts.
  PRESIDENT
}

enum MembershipStatus {
  PENDING
  APPROVED
  REJECTED
}

/// CNI (Cameroonian national ID card) is the only accepted identity
/// document — passport verification was removed entirely.
enum KycDocumentType {
  CNI
}

enum KycVerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

/// Every weekly/biweekly value follows the same shape as the original
/// HEBDO_SUNDAY/BIWEEKLY_SUNDAY, just generalized to every weekday, so
/// admins aren't limited to Sunday-only cycles. Every monthly value follows
/// MONTHLY_25/MONTHLY_28's shape for a curated set of common days. See
/// isContributionDay() in src/lib/tontine-engine.ts for the single lookup
/// table all of these are derived from.
enum TontineType {
  HEBDO_SUNDAY
  EVERY_MONDAY
  EVERY_TUESDAY
  EVERY_WEDNESDAY
  EVERY_THURSDAY
  EVERY_FRIDAY
  EVERY_SATURDAY
  MONTHLY_1
  MONTHLY_5
  MONTHLY_10
  MONTHLY_15
  MONTHLY_20
  MONTHLY_25
  MONTHLY_28
  /// Every other Sunday — a fixed calendar-wide cadence (not anchored to
  /// any individual session's startDate), same for every BIWEEKLY_* value.
  BIWEEKLY_SUNDAY
  BIWEEKLY_MONDAY
  BIWEEKLY_TUESDAY
  BIWEEKLY_WEDNESDAY
  BIWEEKLY_THURSDAY
  BIWEEKLY_FRIDAY
  BIWEEKLY_SATURDAY
  /// The 25th, every 3 months (Jan/Apr/Jul/Oct-style quarterly cadence
  /// anchored to the session's startDate month).
  QUARTERLY_25
}

enum TontineStatus {
  DRAFT
  DRAWING
  ACTIVE
  CLOSED
}

enum ContributionStatus {
  PAID
  LATE
  PENDING
  /// A payment attempt was made and Fapshi reported FAILED/EXPIRED — never
  /// blocks retrying (only PAID does); see failureReason for why.
  FAILED
}

enum FineStatus {
  UNPAID
  PAID
  DEDUCTED
  /// A payment attempt was made and Fapshi reported FAILED/EXPIRED — still
  /// payable again, same as UNPAID; see failureReason for why.
  FAILED
}

enum SwapStatus {
  PENDING_MEMBERSHIP
  PENDING_ADMIN
  APPROVED
  REJECTED
}

enum NotificationType {
  REMINDER_NOON
  REMINDER_URGENT
  PAYMENT_SUCCESS
  FINE_NOTICE
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  IN_APP
  /// Web Push, delivered via the service worker's `push` event — the only
  /// channel that can reach a member while the app is closed/backgrounded.
  /// See src/lib/push/send.ts and the PushSubscription model below.
  PUSH
}

enum NotificationEventType {
  CONTRIBUTION_REMINDER
  FINE_REMINDER
  FOOD_TURN
  PAYMENT_SUCCESS
  /// A Fapshi payment attempt came back FAILED/EXPIRED — sent to the payer.
  PAYMENT_FAILED
  ADMIN_BROADCAST
  MEMBER_APPROVED
  MEMBER_REJECTED
  /// A member requested a position exchange — sent to the target member.
  SWAP_REQUEST_CREATED
  /// The target accepted — sent to every ADMIN/PRESIDENT user.
  SWAP_REQUEST_PENDING_ADMIN
  /// Admin approved the exchange — sent to both requester and target.
  SWAP_REQUEST_APPROVED
  /// Admin rejected the exchange — sent to both requester and target.
  SWAP_REQUEST_REJECTED
  /// A new membership join request was created — sent to every ADMIN/PRESIDENT user.
  NEW_MEMBERSHIP_REQUEST
  /// Admin started a cotisation's drawing phase — sent to its approved members.
  DRAW_LAUNCHED
  /// The previous cycle's payout was released, so this member is now next in
  /// line — sent once, right when they become the newly-designated
  /// beneficiary (see getDesignatedSlot in src/lib/round-robin-lock.ts).
  PAYOUT_TURN
  /// An automated duplicate-payment refund failed 3 times and needs manual
  /// review — sent to every ADMIN/PRESIDENT user.
  PAYMENT_REFUND_ESCALATED
}

enum NotificationStatus {
  PENDING
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

enum OtpPurpose {
  EMAIL_CHANGE
  PHONE_CHANGE
  PASSWORD_CHANGE
}

enum PaymentMethodType {
  MOBILE_MONEY
}

/// The Cameroonian mobile money network a phone number belongs to — always
/// derived server-side from the number's prefix (see
/// src/lib/mobile-money-provider.ts), never trusted from client input.
/// Passed through to Fapshi as `medium` so it routes to the right network
/// instead of relying on Fapshi's own auto-detection.
enum MobileMoneyProvider {
  ORANGE
  MTN
}

/// The payment gateway that processed a Contribution — see
/// src/lib/payment-fees.ts for its fee structure. Fapshi (Mobile
/// Money/Orange Money) is the platform's sole payment gateway — Kora
/// (card payments) was removed entirely, never having been wired into a
/// live checkout flow.
enum PaymentProvider {
  FAPSHI
}

/// Lifecycle of one Fapshi transaction attempt, tracked independently of the
/// mutable Contribution.fapshiTxRef/Fine.fapshiTxRef fields (which only ever
/// hold the CURRENT/latest attempt) so a superseded-but-later-successful
/// transaction can still be recognized and refunded instead of silently lost.
enum PaymentAttemptStatus {
  PENDING
  SUCCESSFUL
  FAILED
  EXPIRED
  /// This transId reached SUCCESSFUL on Fapshi's side, but the target slot's
  /// cycle was already marked PAID by a different transaction — the classic
  /// double-payment race (e.g. a member and a relative paying the same slot
  /// at once). Queued for an automated refund.
  DUPLICATE_PAID
  /// A refund payout call to Fapshi is in flight right now.
  REFUND_INITIATED
  REFUNDED
  /// Automated refund failed 3 times — needs an admin to refund manually.
  REFUND_FAILED_MANUAL_REVIEW
}

/// One row per Fapshi transId ever generated for a Contribution or Fine —
/// the durable ledger behind the duplicate-payment/automated-refund system.
/// Doubles as the refund retry queue (nextRefundAttemptAt/refundAttempts)
/// so no separate Redis/BullMQ infrastructure is needed.
model PaymentAttempt {
  id                 String               @id @default(cuid())
  transId            String               @unique
  contributionId     String?
  fineId             String?
  payerPhone         String
  amount             Decimal              @db.Decimal(12, 2)
  status             PaymentAttemptStatus @default(PENDING)
  refundReason       String?
  refundTransId      String?
  refundedAt         DateTime?
  refundAttempts     Int                  @default(0)
  /// When the refund retry cron should next pick this row up — set with
  /// exponential backoff after each failed attempt.
  nextRefundAttemptAt DateTime?
  lastRefundError    String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  /// Set instead of contributionId/fineId when this attempt paid for a
  /// BulkPayment (several slots' current-cycle contributions in one Fapshi
  /// transaction) rather than a single Contribution/Fine.
  bulkPaymentId String?

  contribution Contribution? @relation(fields: [contributionId], references: [id], onDelete: SetNull)
  fine         Fine?         @relation(fields: [fineId], references: [id], onDelete: SetNull)
  bulkPayment  BulkPayment?  @relation(fields: [bulkPaymentId], references: [id], onDelete: SetNull)

  @@index([contributionId])
  @@index([fineId])
  @@index([bulkPaymentId])
  @@index([status, nextRefundAttemptAt])
  @@map("payment_attempts")
}

/// One combined Fapshi transaction covering several MembershipSlots'
/// current-cycle Contributions at once — e.g. a member holding 3 named
/// slots under one membership (or across several) paying all 3 in a
/// single USSD prompt instead of three separate ones. Deliberately scoped
/// to Contributions only, not Fines, which stay on the existing per-fine
/// payment flow. See src/lib/initiate-bulk-payment.ts.
model BulkPayment {
  id            String               @id @default(cuid())
  userId        String
  /// Null until the Fapshi call succeeds — the row is created first (inside
  /// the same row-locked transaction that claims every included slot) so
  /// the anti-race check-and-claim pattern matches single-slot payments.
  transId       String?              @unique
  payerPhone    String
  amount        Decimal              @db.Decimal(12, 2)
  status        PaymentAttemptStatus @default(PENDING)
  failureReason String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions   Contribution[]
  paymentAttempts PaymentAttempt[]

  @@index([userId, createdAt])
  @@map("bulk_payments")
}

model User {
  id                   String    @id @default(cuid())
  email                String    @unique
  emailVerified        DateTime?
  name                 String
  avatar               String?
  image                String?
  role                 Role      @default(MEMBER)
  city                 String?
  neighborhood         String?
  /// Captured from the browser's Geolocation API via the "Enable
  /// Geolocation" button on the profile page — city/neighborhood above stay
  /// free-text and editable regardless of whether these are set.
  latitude             Decimal?  @db.Decimal(9, 6)
  longitude            Decimal?  @db.Decimal(9, 6)
  /// E.164-ish digits-only phone number used for WhatsApp notifications (Evolution API).
  phone                String?
  /// Optional separate mobile-money number for admin payouts, when it
  /// differs from the WhatsApp contact number above. Falls back to `phone`
  /// when null.
  payoutPhone          String?
  /// "en" | "fr" — synced from the language cookie whenever a signed-in user
  /// switches language, so server-side flows with no request-scoped cookie
  /// access (e.g. the support auto-reply bot) can still localize correctly.
  preferredLang        String?
  /// Throttles the support-chat auto-reply bot to once per rolling 30 days.
  lastAdminAutoReplyAt DateTime?
  /// Generated once, the first time any of this user's memberships is
  /// approved (see src/lib/member-code.ts). Stable across every
  /// contribution the user is part of; admin can regenerate it. Lets a
  /// relative/friend look the member up via "Contribute for a Relative"
  /// without exposing email/phone. Null until their first approval.
  memberCode           String?   @unique
  createdAt            DateTime  @default(now())

  accounts                     Account[]
  sessions                     Session[]
  memberships                  Membership[]
  contributionsRecordedAsAdmin Contribution[]        @relation("ContributionRecordedByAdmin")
  paymentsMadeForOthers        Contribution[]        @relation("ContributionPaidBy")
  bulkPayments                 BulkPayment[]
  swapRequestsMade             PositionSwapRequest[] @relation("SwapRequester")
  swapRequestsReceived         PositionSwapRequest[] @relation("SwapTarget")
  messagesSent                 ChatMessage[]         @relation("MessageSender")
  messagesReceived             ChatMessage[]         @relation("MessageReceiver")
  notificationLogs             NotificationLog[]
  notifications                Notification[]
  auditLogs                    AuditLog[]
  kycVerifications             KycVerification[]
  otpChallenges                OtpChallenge[]
  payoutsReleasedAsAdmin       Payout[]              @relation("PayoutReleasedByAdmin")
  savedPaymentMethods          SavedPaymentMethod[]
  transactionArchives          TransactionArchive[]
  pushSubscriptions            PushSubscription[]

  @@map("users")
}

/// A user's saved Mobile Money/Orange Money payer number shortcut — max 4
/// per user, enforced at the API layer (src/app/api/profile/payment-
/// methods/route.ts). `provider` is always server-derived from `phone` at
/// save time (see src/lib/mobile-money-provider.ts), never client-supplied,
/// so it can't drift from what the number actually is.
model SavedPaymentMethod {
  id        String              @id @default(cuid())
  userId    String
  type      PaymentMethodType   @default(MOBILE_MONEY)
  provider  MobileMoneyProvider
  label     String?
  /// Normalized 9-digit Cameroonian MSISDN, no country code (e.g. "677123456").
  phone     String
  isDefault Boolean             @default(false)
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, phone])
  @@map("saved_payment_methods")
}

/// Short-lived numeric verification codes gating changes to sensitive
/// profile fields (email, phone, password). Always delivered via WhatsApp
/// (see src/lib/otp.ts) — a DB row (not a stateless token) so requests can
/// be rate-limited, invalidated on use, and capped on brute-force attempts.
model OtpChallenge {
  id           String     @id @default(cuid())
  userId       String
  purpose      OtpPurpose
  /// sha256(code + OTP_PEPPER) — the plaintext code is never stored.
  codeHash     String
  /// New value being verified toward (new email/phone). Null for
  /// PASSWORD_CHANGE, which has nothing new to stage.
  pendingValue String?
  expiresAt    DateTime
  consumedAt   DateTime?
  attempts     Int        @default(0)
  createdAt    DateTime   @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("otp_challenges")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model TontineSession {
  id                  String        @id @default(cuid())
  title               String?
  description         String?       @db.Text
  type                TontineType
  /// Per-slot amount.
  amount              Decimal       @db.Decimal(12, 2)
  /// Per-slot service/platform fee.
  fee                 Decimal       @db.Decimal(12, 2)
  status              TontineStatus @default(DRAFT)
  startDate           DateTime
  limitTime           String
  /// Maximum total registered slots (sum of Membership.slotCount) this
  /// session accepts. Null = uncapped. Reaching this locks new join
  /// requests the same way passing startDate does.
  maxSlots            Decimal?      @db.Decimal(5, 1)
  /// Per-session fine amount/interval, overriding the global
  /// TONTINE_CONFIG table (which is now form-prefill-only). Null on old
  /// rows predating this field — computeFine() falls back to the global
  /// table in that case.
  fineAmountPerPeriod Decimal?      @db.Decimal(12, 2)
  fineIntervalHours   Int?
  /// Explicit admin-set date the draw/ranking tools unlock on. Null means
  /// not yet configured — treated as "never unlocked" until the admin
  /// edits the session to set one.
  drawDate            DateTime?
  /// Reversible — blocks new joins + new payments while true. Independent
  /// of status so it can be toggled at any lifecycle stage.
  isPaused            Boolean       @default(false)
  /// Irreversible once set — blocks new joins only (same effect as
  /// maxSlots/startDate already have); doesn't affect payments in progress.
  lockedAt            DateTime?

  memberships      Membership[]
  swapRequests     PositionSwapRequest[]
  notificationLogs NotificationLog[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  kycVerifications KycVerification[]
  payouts          Payout[]

  @@map("tontine_sessions")
}

model Membership {
  id               String           @id @default(cuid())
  userId           String
  tontineSessionId String
  status           MembershipStatus @default(PENDING)
  /// How many named, positioned MembershipSlot rows this membership gets —
  /// a whole number from 1 to 5 (enforced at the API layer; fractional/
  /// half-slot billing was removed). Null until the member selects it
  /// (mandatory one-time step after approval).
  slotCount        Int?
  joinedAt         DateTime         @default(now())
  /// Optional, admin-entered when rejecting a join request — shown to the
  /// member in their rejection notification when present.
  rejectionReason  String?          @db.Text
  /// Set when the member dismisses this membership from their own /sessions
  /// view after the admin has closed the cotisation (tontineSession.status
  /// = CLOSED) — purely a per-member display preference, never touches the
  /// underlying data, and only takes effect once the session is actually
  /// closed (dismissing an active one has no route to set this).
  hiddenByMemberAt DateTime?

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tontineSession  TontineSession   @relation(fields: [tontineSessionId], references: [id], onDelete: Cascade)
  kycVerification KycVerification?
  slots           MembershipSlot[]

  @@unique([userId, tontineSessionId])
  @@map("memberships")
}

/// One row per named, positioned slot — Membership.slotCount rows per
/// membership, created together when the member selects their slots. Each
/// slot has its own draw position and its own fully independent
/// contribution/payment history (a third party can pay for one named slot
/// while a sibling slot under the same membership stays unpaid).
model MembershipSlot {
  id               String   @id @default(cuid())
  membershipId     String
  beneficiaryName  String
  /// Final payout order (1..N) for this slot, set by the admin when
  /// publishing the official ranking. Null until published. Kept hidden
  /// from members until they individually "draw" (see ballDrawn) — the
  /// draw animation is real, but always reveals this pre-assigned value.
  officialPosition Int?
  /// Set the moment this slot's own member has clicked through their draw
  /// reveal — always equal to officialPosition once set (the draw never
  /// generates a different number). Doubles as the "publicly visible"
  /// gate: other members can't see this slot's officialPosition until
  /// ballDrawn is set. Null until revealed.
  ballDrawn        Int?
  createdAt        DateTime @default(now())

  membership    Membership     @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  contributions Contribution[]
  fines         Fine[]
  payouts       Payout[]
  foodTurnLogs  FoodTurnLog[]

  @@map("membership_slots")
}

enum PayoutStatus {
  DETAILS_SUBMITTED
  RELEASED
  CONFIRMED
}

/// The full beneficiary-payout lifecycle — one row per session per cycle,
/// created the moment a beneficiary submits their payout details (not at
/// release time). Existence of a row with a non-null `releasedAt` is the
/// single source of truth for "has this cycle's designated beneficiary
/// actually been paid out yet," which the round-robin pre-pay-ahead lock
/// (src/lib/round-robin-lock.ts) depends on.
model Payout {
  id                 String       @id @default(cuid())
  tontineSessionId   String
  membershipSlotId   String
  /// The cycle (Contribution.dueDate-style key) this payout closes out.
  dueDate            DateTime
  status             PayoutStatus @default(DETAILS_SUBMITTED)
  /// Beneficiary-submitted, for this payout only — distinct from the
  /// profile-level User.payoutPhone/phone, which are never used for the
  /// actual transfer once this flow exists.
  payoutPhone        String
  payoutAccountName  String
  detailsSubmittedAt DateTime     @default(now())
  /// All null until the admin actually executes the transfer.
  pot                Decimal?     @db.Decimal(12, 2)
  deducted           Decimal?     @db.Decimal(12, 2)
  netPayout          Decimal?     @db.Decimal(12, 2)
  /// Fapshi payout transaction id (POST /payout response.transId).
  fapshiTransId      String?      @unique
  releasedByAdminId  String?
  releasedAt         DateTime?
  memberConfirmedAt  DateTime?
  /// True if the admin used the "mark confirmed" override instead of the
  /// beneficiary confirming receipt themselves.
  confirmedByAdmin   Boolean      @default(false)

  tontineSession  TontineSession @relation(fields: [tontineSessionId], references: [id], onDelete: Cascade)
  membershipSlot  MembershipSlot @relation(fields: [membershipSlotId], references: [id], onDelete: Cascade)
  releasedByAdmin User?          @relation("PayoutReleasedByAdmin", fields: [releasedByAdminId], references: [id])

  @@unique([tontineSessionId, dueDate])
  @@map("payouts")
}

/// One row per KYC (Didit) verification attempt. Created when a member
/// starts identity verification to join a specific tontine — before a
/// Membership exists — and linked to the resulting Membership once the
/// member submits their documents. An admin reviews documentImageUrl +
/// selfieImageUrl by hand (see /admin/membership-requests) and the
/// decide route sets status to VERIFIED/FAILED to match their decision.
/// diditSessionId/matchConfidence are legacy from the previous automated
/// Didit integration (removed — per-verification cost wasn't viable for
/// this association) and are now unused/nullable rather than deleted, so
/// old rows stay intact.
model KycVerification {
  id                   String                @id @default(cuid())
  userId               String
  tontineSessionId     String
  membershipId         String?               @unique
  documentType         KycDocumentType
  status               KycVerificationStatus @default(PENDING)
  diditSessionId       String?               @unique
  matchConfidence      Decimal?              @db.Decimal(5, 2)
  /// Front side of a CNI, or the passport's photo page.
  documentImageUrl     String?
  /// Back side of a CNI. Always null for PASSPORT — passports only need
  /// the one photo page.
  documentBackImageUrl String?
  /// Selfie photo submitted alongside the document, for the admin to
  /// visually compare during manual review.
  selfieImageUrl       String?
  /// Full name of whoever told this applicant about the cotisation —
  /// collected at submission time so an admin can see who's driving
  /// referrals. Required at the API layer; nullable here only because rows
  /// created before this field existed have none.
  referrerName         String?
  referrerPhone        String?
  createdAt            DateTime              @default(now())
  verifiedAt           DateTime?

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tontineSession TontineSession @relation(fields: [tontineSessionId], references: [id], onDelete: Cascade)
  membership     Membership?    @relation(fields: [membershipId], references: [id], onDelete: SetNull)

  @@index([userId, tontineSessionId])
  @@map("kyc_verifications")
}

model Contribution {
  id                      String             @id @default(cuid())
  membershipSlotId        String
  /// Calendar date (Cameroon-local) of the contribution cycle this row belongs
  /// to — each Sunday for HEBDO_SUNDAY, the 25th/28th for the monthly types.
  dueDate                 DateTime
  amountPaid              Decimal            @db.Decimal(12, 2)
  feePaid                 Decimal            @db.Decimal(12, 2)
  finePaid                Decimal            @default(0) @db.Decimal(12, 2)
  status                  ContributionStatus @default(PENDING)
  fapshiTxRef             String?            @unique
  /// Mobile Money / Orange Money number the USSD prompt was sent to for
  /// this attempt — captured explicitly at checkout, distinct from the
  /// beneficiary's own profile phone when a relative/friend pays instead.
  payerPhone              String?
  /// Set when a Fapshi attempt comes back FAILED/EXPIRED — Fapshi's own
  /// `reason` field when present, otherwise a generic note. Cleared on the
  /// next attempt. Never blocks retrying (only status = PAID does).
  failureReason           String?
  paidAt                  DateTime?
  receiptPdfUrl           String?
  createdAt               DateTime           @default(now())
  /// Bumped on every payment attempt — used to tell a fresh in-flight
  /// attempt apart from an abandoned one when guarding against a second
  /// concurrent payment for the same slot+cycle.
  updatedAt               DateTime           @updatedAt
  /// Set only when an admin records this contribution manually (off-platform
  /// payment) rather than it being confirmed via the Fapshi webhook.
  recordedByAdminId       String?
  /// Who physically paid — distinct from the slot's owning member. Null
  /// means self-paid by the slot's own member (the historical default).
  /// Set when a relative/friend pays via the "Contribute for a Relative"
  /// flow. Independent of recordedByAdminId, which tracks admin manual
  /// entries specifically.
  paidByUserId            String?
  /// Which payment gateway processed this transaction. Null for
  /// admin-recorded (manual, off-platform) payments — there's no gateway
  /// fee to compute when no gateway was involved.
  paymentProvider         PaymentProvider?
  /// Total payment-processing fee charged to the payer on top of
  /// amountPaid+feePaid+finePaid (e.g. 3.3% for Fapshi). Null when
  /// paymentProvider is null. Never shown to ordinary users broken down —
  /// only the total is shown at confirmation (see src/lib/payment-fees.ts).
  providerFeeAmount       Decimal?           @db.Decimal(12, 2)
  /// The gateway's own cut of providerFeeAmount (e.g. Fapshi's 3.0%).
  /// President-only visibility, enforced server-side.
  providerShareAmount     Decimal?           @db.Decimal(12, 2)
  /// The President's cut of providerFeeAmount (e.g. Fapshi's 0.3%).
  /// President-only visibility, enforced server-side.
  presidentFeeShareAmount Decimal?           @db.Decimal(12, 2)
  /// Set when this contribution was paid as part of a combined Global
  /// Payment (see BulkPayment) rather than individually.
  bulkPaymentId           String?

  membershipSlot  MembershipSlot @relation(fields: [membershipSlotId], references: [id], onDelete: Cascade)
  recordedByAdmin User?          @relation("ContributionRecordedByAdmin", fields: [recordedByAdminId], references: [id])
  paidByUser      User?          @relation("ContributionPaidBy", fields: [paidByUserId], references: [id])
  bulkPayment     BulkPayment?   @relation(fields: [bulkPaymentId], references: [id], onDelete: SetNull)
  paymentAttempts PaymentAttempt[]

  @@unique([membershipSlotId, dueDate])
  @@index([bulkPaymentId])
  @@map("contributions")
}

model Fine {
  id               String     @id @default(cuid())
  membershipSlotId String
  /// Same cycle key as Contribution.dueDate — one fine per slot per cycle,
  /// recomputed (upserted) idempotently by the daily penalty cron.
  dueDate          DateTime
  amount           Decimal    @db.Decimal(12, 2)
  status           FineStatus @default(UNPAID)
  fapshiTxRef      String?    @unique
  /// Mobile Money / Orange Money number the USSD prompt was sent to for
  /// this attempt — see Contribution.payerPhone for the same idea.
  payerPhone       String?
  /// Set when a Fapshi attempt comes back FAILED/EXPIRED — see
  /// Contribution.failureReason.
  failureReason    String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  membershipSlot  MembershipSlot   @relation(fields: [membershipSlotId], references: [id], onDelete: Cascade)
  paymentAttempts PaymentAttempt[]

  @@unique([membershipSlotId, dueDate])
  @@map("fines")
}

/// DB-level constraint not expressible here: a partial unique index on
/// (tontineSessionId, LEAST(requesterId, targetId), GREATEST(requesterId,
/// targetId)) WHERE status IN ('PENDING_MEMBERSHIP', 'PENDING_ADMIN') — an
/// unordered-pair index so A-requests-B and B-requests-A collide on the
/// same key. See the hand-written migrations
/// 20260827160100_swap_request_unique_pending_index and
/// 20260827160200_swap_request_symmetric_pending_index. Don't let a future
/// `prisma migrate diff` drop it; Prisma has no syntax to declare it here.
model PositionSwapRequest {
  id               String     @id @default(cuid())
  requesterId      String
  targetId         String
  tontineSessionId String
  status           SwapStatus @default(PENDING_MEMBERSHIP)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  requester      User           @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target         User           @relation("SwapTarget", fields: [targetId], references: [id], onDelete: Cascade)
  tontineSession TontineSession @relation(fields: [tontineSessionId], references: [id], onDelete: Cascade)

  @@map("position_swap_requests")
}

model ChatMessage {
  id         String    @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  createdAt  DateTime  @default(now())
  /// Set when the receiver opens this conversation thread — powers the
  /// unread-messages badge in the top-right menu.
  readAt     DateTime?

  sender   User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, readAt])
  @@map("chat_messages")
}

/// Records which WhatsApp notifications have already been sent for a given
/// user + session + cycle, so the noon/urgent reminder crons (and the fine
/// notice sent from the penalty cron) stay idempotent across retries/re-runs.
model NotificationLog {
  id               String           @id @default(cuid())
  userId           String
  tontineSessionId String
  dueDate          DateTime
  type             NotificationType
  sentAt           DateTime         @default(now())

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tontineSession TontineSession @relation(fields: [tontineSessionId], references: [id], onDelete: Cascade)

  @@unique([userId, tontineSessionId, dueDate, type])
  @@map("notification_logs")
}

/// Unified admin-triggered / in-app notification queue. Distinct from
/// NotificationLog above (which the 3 existing daily WhatsApp crons keep
/// using untouched, as a proven idempotency ledger) — this model is the new
/// system for anything admin-triggered (reminders, broadcasts) or shown to
/// a user in-app, with a real pending/scheduled/sent/failed lifecycle so
/// bulk sends can be staggered and survive the admin closing their browser.
model Notification {
  id               String                @id @default(cuid())
  tontineSessionId String?
  userId           String
  membershipSlotId String?
  channel          NotificationChannel
  type             NotificationEventType
  /// Rendered fallback text (recipient's language at creation time) — used
  /// for EMAIL/WHATSAPP delivery as-is, and as the IN_APP display fallback
  /// when messageKey is null (rows created before it existed, or freeform
  /// admin-authored text like ADMIN_BROADCAST that has no translation key).
  message          String                @db.Text
  /// i18n key + interpolation vars for IN_APP rows — lets the feed render
  /// in whichever language is CURRENTLY selected (see translate() in
  /// src/lib/i18n/translations.ts), instead of being stuck in whatever
  /// language `message` was rendered in at creation time.
  messageKey       String?
  messageVars      Json?
  status           NotificationStatus    @default(PENDING)
  scheduledAt      DateTime              @default(now())
  sentAt           DateTime?
  retryCount       Int                   @default(0)
  errorMessage     String?
  /// Set when the recipient opens/dismisses this in their "My
  /// Notifications" feed. Irrelevant for EMAIL/WHATSAPP rows.
  readAt           DateTime?
  createdAt        DateTime              @default(now())
  /// Client-side navigation target when the recipient taps this
  /// notification in their feed (e.g. "/chat", "/admin/swap-requests").
  /// Null for rows created before this field existed, or for types with no
  /// obvious single destination.
  actionUrl        String?

  tontineSession TontineSession? @relation(fields: [tontineSessionId], references: [id], onDelete: Cascade)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([tontineSessionId, status])
  @@index([status, scheduledAt])
  @@map("notifications")
}

/// One row per browser/device the user has granted Web Push permission on
/// (a user can have several — phone + desktop, or after reinstalling the
/// PWA). `endpoint` is the push service URL the browser vendor assigns that
/// subscription; `p256dh`/`auth` are the keys needed to encrypt a payload
/// for it. See src/lib/push/send.ts for how these are used, and
/// src/app/api/push/subscribe/route.ts for how they're created/refreshed.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique @db.Text
  p256dh    String   @db.Text
  auth      String   @db.Text
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

/// One row per member per fully-elapsed calendar year with any Contribution
/// or Fine history — a PDF snapshot of that year's transactions, generated
/// by a daily cron once the year has closed. periodStart/periodEnd are
/// always Jan 1 / Dec 31 (UTC) of the same calendar year. The underlying
/// Contribution/Fine rows are never deleted — this is purely a snapshot +
/// a display-time filter on the active history list.
model TransactionArchive {
  id          String   @id @default(cuid())
  userId      String
  periodStart DateTime
  periodEnd   DateTime
  pdfUrl      String
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodStart])
  @@map("transaction_archives")
}

/// Idempotency for the automatic "it's your food/payout turn" cron —
/// mirrors NotificationLog's unique-constraint trick so the same slot never
/// gets the fun reveal message twice for the same cycle.
model FoodTurnLog {
  id               String   @id @default(cuid())
  membershipSlotId String
  dueDate          DateTime
  sentAt           DateTime @default(now())

  membershipSlot MembershipSlot @relation(fields: [membershipSlotId], references: [id], onDelete: Cascade)

  @@unique([membershipSlotId, dueDate])
  @@map("food_turn_logs")
}

/// Append-only trail of important admin/member actions. actorId is
/// nullable (not onDelete: Cascade) so deleting a user account never wipes
/// the historical record of what they did — see logAudit() in
/// src/lib/audit.ts, called fire-and-forget from every sensitive route.
enum AuditLogStatus {
  SUCCESS
  FAILED
  BLOCKED
}

/// Append-only security/activity trail. Immutable at the DB level — see the
/// audit_logs_no_update/audit_logs_no_delete triggers added in
/// 20260902120000_audit_log_hardening/migration.sql, which reject any
/// UPDATE/DELETE regardless of which role or connection issues it. Written
/// exclusively through src/lib/audit.ts's logAudit(), a fire-and-forget
/// helper that never throws or blocks the operation it's recording.
model AuditLog {
  id               String         @id @default(cuid())
  actorId          String?
  /// Snapshot of the actor's role AT THE TIME of the action — a user's role
  /// can change later, so this must never be looked up live from `actor`.
  actorRole        Role?
  action           String
  /// Target entity type — e.g. "User", "TontineSession", "Contribution".
  targetType       String
  targetId         String?
  tontineSessionId String?
  /// Free-form context that doesn't fit the before/after snapshot shape
  /// (e.g. a broadcast's subject line, a reminder's recipient count).
  metadata         Json?
  /// State of the target resource before this action, when applicable
  /// (e.g. a member's profile/KYC snapshot at approval time).
  payloadBefore    Json?
  /// State of the target resource after this action, when applicable.
  payloadAfter     Json?
  ipAddress        String?
  userAgent        String?
  status           AuditLogStatus @default(SUCCESS)
  /// Why the action failed or was blocked — set only when status != SUCCESS.
  failureReason    String?
  createdAt        DateTime       @default(now())

  actor          User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  tontineSession TontineSession? @relation(fields: [tontineSessionId], references: [id], onDelete: SetNull)

  @@index([tontineSessionId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([status, createdAt])
  @@map("audit_logs")
}

/// Singleton row (id is always "singleton") holding the association's
/// general rules — replaces the old per-cotisation `rules` field. Shown at
/// /reglement-general (linked from the member Profile tab) and editable by
/// any admin from /admin/settings.
model AssociationRules {
  id               String   @id @default("singleton")
  content          String   @db.Text
  updatedAt        DateTime @updatedAt
  updatedByAdminId String?

  @@map("association_rules")
}
